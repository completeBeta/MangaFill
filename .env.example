# Copy to .env and fill in. NEVER commit .env.

# OpenRouter gateway — translation is cloud-only (no local GPU).
# Model is configurable; default start is Gemini Flash (johnnyk's preference).
OPENROUTER_API_KEY=

# Optional fallback providers (used only if OpenRouter is unreachable).
DEEPSEEK_API_KEY=

# Optional app overrides (defaults in app/config.py)
# MANGA_FILL_PORT=8788
# MANGA_FILL_DRY_RUN=true
