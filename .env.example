# Copy to .env and fill in. NEVER commit .env.

# Seed for the DEFAULT translation model, created on first boot. Models are
# managed (add/remove) from the web UI Settings tab — this only provides one
# starting model. Any OpenAI-compatible endpoint works.
MANGA_FILL_DEFAULT_MODEL=deepseek-v4-flash
MANGA_FILL_DEFAULT_BASE_URL=https://api.deepseek.com/v1
MANGA_FILL_DEFAULT_API_KEY=

# Optional app overrides (defaults in app/config.py)
# MANGA_FILL_PORT=8788
# MANGA_FILL_DRY_RUN=true
# MANGA_FILL_OUTPUT_MODE=folder
