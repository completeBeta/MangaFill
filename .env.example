# Copy to .env and fill in. NEVER commit .env.

# --- Translation (cloud-only, no local GPU) ---
# These are the initial defaults; model / base URL / keys are ALSO editable at
# runtime from the web UI Settings tab (persisted in SQLite).
MANGA_FILL_DEEPSEEK_API_KEY=
MANGA_FILL_DEEPSEEK_MODEL=deepseek-v4-flash
MANGA_FILL_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

MANGA_FILL_OPENROUTER_API_KEY=
MANGA_FILL_OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
MANGA_FILL_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional app overrides (defaults in app/config.py)
# MANGA_FILL_PORT=8788
# MANGA_FILL_DRY_RUN=true
# MANGA_FILL_OUTPUT_MODE=folder
